<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

    <xacro:macro name="imu" params="sensor_name parent_link *origin">

        <xacro:property name="imu_size" value="0.05" />
        <xacro:property name="imu_m" value="0.01" /> <!-- imu质量 -->
        <xacro:macro name="Box_inertial_matrix" params="m l w h">
            <inertial>
                <mass value="${m}" />
                <inertia ixx="${m*(h*h + l*l)/12}" ixy="0" ixz="0"
                    iyy="${m*(w*w + l*l)/12}" iyz="0"
                    izz="${m*(w*w + h*h)/12}" />
            </inertial>
        </xacro:macro>

        <!-- imu -->
        <joint name="imutobase" type="fixed">
            <xacro:insert_block name="origin" />
            <parent link="${parent_link}" />
            <child link="imu_base" />
        </joint>

        <link name="imu_base">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0" />
                <geometry>
                    <box size="${imu_size} ${imu_size} ${imu_size}" />
                </geometry>
                <material name="black">
                    <color rgba="1.0 0.0 0.0 0.6" />
                </material>
            </visual>
            <collision>
                <geometry>
                    <box size="${imu_size} ${imu_size} ${imu_size}" />
                </geometry>
                <origin xyz="0.0 0.0 0" rpy="0.0 0.0 0.0" />
            </collision>
            <xacro:Box_inertial_matrix m="${imu_m}" l="${imu_size}" w="${imu_size}" h="${imu_size}" />
        </link>

        <!-- 被引用的link -->
        <gazebo reference="imu_base">
            <material>Gazebo/Green</material>
            <gravity>true</gravity>
            <sensor name="imu_sensor" type="imu">
                <always_on>true</always_on>
                <update_rate>1000</update_rate>
                <visualize>true</visualize>
                <topic>__default_topic__</topic>
                <!-- ROS2/Harmonic native sensor; ros_gz_bridge maps imu/data. -->
                <gz_frame_id>imu_base</gz_frame_id>
                <pose>0 0 0 0 0 0</pose>
            </sensor>
        </gazebo>

    </xacro:macro>
</robot>
