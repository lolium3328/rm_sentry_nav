<?xml version="1.0"?>
<!-- ROS2 adapter for legacy velodyne_description/urdf/HDL-32E.urdf.xacro. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="hdl32e" params="parent *origin">
    <joint name="velodyne_base_joint" type="fixed"><xacro:insert_block name="origin"/><parent link="${parent}"/><child link="velodyne_base"/></joint>
    <link name="velodyne_base"><visual><geometry><mesh filename="package://mbot_description/meshes/HDL32E_base.dae"/></geometry></visual></link>
    <joint name="velodyne_joint" type="fixed"><origin xyz="0 0 0.09081"/><parent link="velodyne_base"/><child link="velodyne"/></joint>
    <link name="velodyne"><visual><origin xyz="0 0 -0.09081"/><geometry><mesh filename="package://mbot_description/meshes/HDL32E_scan.dae"/></geometry></visual></link>
    <gazebo reference="${parent}">
      <sensor name="velodyne-HDL32E" type="gpu_lidar">
        <topic>lidar</topic><update_rate>10</update_rate><visualize>true</visualize><gz_frame_id>velodyne</gz_frame_id>
        <lidar><scan><horizontal><samples>2187</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal><vertical><samples>32</samples><resolution>1</resolution><min_angle>-0.535292</min_angle><max_angle>0.186227</max_angle></vertical></scan><range><min>0.3</min><max>131</max><resolution>0.001</resolution></range></lidar>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
